{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/downloads/(.*).tgz",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/gzip"
        }
      ]
    },
    {
      "source": "/downloads/(.*).zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        }
      ]
    }
  ]
}
